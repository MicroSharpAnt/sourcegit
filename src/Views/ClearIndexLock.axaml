<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             x:Class="SourceGit.Views.ClearIndexLock"
             x:DataType="vm:ClearIndexLock">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16"
            Data="{StaticResource Icons.Unlock}"/>

      <TextBlock FontSize="18"
                 Margin="8,0,0,0"
                 Classes="bold"
                 Text="{DynamicResource Text.Repository.ClearIndexLock}"/>
    </StackPanel>

    <TextBlock Text="{DynamicResource Text.Repository.ClearIndexLock.Confirm}"
               Margin="0,16,0,0"
               TextWrapping="Wrap"/>
    <TextBlock Text="{Binding LockPath}" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.65"/>
  </StackPanel>
</UserControl>
