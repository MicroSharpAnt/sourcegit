<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:SourceGit.Views"
             x:Class="SourceGit.Views.TablePreviewView">
  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource Brush.Contents}">
    <Grid Margin="8,4" ColumnDefinitions="*,Auto">
      <ListBox x:Name="Sheets" Background="Transparent" SelectionChanged="OnSheetChanged"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>
      <CheckBox x:Name="Raw" Grid.Column="1" Content="{DynamicResource Text.TablePreview.Raw}" IsCheckedChanged="OnRawChanged"/>
    </Grid>
    <StackPanel Grid.Row="1" Margin="8,0,8,4" Spacing="4">
      <TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"/>
      <TextBlock x:Name="Truncated" Text="{DynamicResource Text.TablePreview.Truncated}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"/>
      <TextBlock x:Name="Empty" Text="{DynamicResource Text.TablePreview.Empty}" Foreground="{DynamicResource Brush.FG2}"/>
      <TextBlock x:Name="ValuesOnly" Text="{DynamicResource Text.TablePreview.ValuesOnly}" Foreground="{DynamicResource Brush.FG2}"/>
    </StackPanel>
    <DataGrid x:Name="Table" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="True"
              HeadersVisibility="All" GridLinesVisibility="All" RowHeight="28" RowHeaderWidth="48"/>
    <v:RevisionTextFileView x:Name="RawText" Grid.Row="2" IsVisible="False" FontFamily="{DynamicResource Fonts.Monospace}"/>
  </Grid>
</UserControl>
